DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_learning_portfolio?schema=public"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 選填：提高 GitHub Metadata 同步額度。請勿提交真實 Token。
GITHUB_TOKEN=""

# 選填：CWA 即時 OpenData 模式。只允許存於伺服器環境，不得加 NEXT_PUBLIC_ 前綴。
CWA_API_KEY=""

# 選填：中央 AI Gateway。未設定時，ML 助教自動使用教材 fallback。
# 只允許存於伺服器 Secret，不得加 NEXT_PUBLIC_ 前綴。
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# 選填：費率由營運者依實際合約自行設定；空白時只記 Token，不估算成本。
AI_GEMINI_INPUT_USD_PER_1M=""
AI_GEMINI_OUTPUT_USD_PER_1M=""

# 選填：本機 JSONL 使用紀錄。Serverless 正式環境應改寫入 PostgreSQL。
AI_USAGE_LOG_PATH="ai_usage_logs/runtime.jsonl"

# AI API 基本流量保護。正式多實例環境應改用 Redis／資料庫型 Rate Limiter。
AI_RATE_LIMIT_MAX="10"
AI_RATE_LIMIT_WINDOW_SECONDS="600"
